# ==========================================
# AROMI Backend Environment Variables
# ==========================================

# Application & Environment
ENVIRONMENT=development
# Supabase PostgreSQL Connection String (Pooler / Direct)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Local SQLite fallback: sqlite:///./aromi.db
SUPABASE_URL=
SUPABASE_KEY=

# Security & Authentication (JWT)
JWT_SECRET=aromi-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & AI Services (OpenRouter)
# Add your OpenRouter API Key below to enable real-time Vision, RAG, and Agent responses
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3-haiku

# Storage & AI Engine Settings
CHROMA_PERSIST_DIR=./chroma_db
TTS_MODEL=piper
WHISPER_MODEL=base

# Twilio Notification Escalation (Optional: WhatsApp + Hindi Voice alerts for SAM emergencies)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_CALLER_NUMBER=+1XXXXXXXXXX
ALERT_PARENT_NUMBER=+91XXXXXXXXXX
ALERT_SUPERVISOR_NUMBER=+91XXXXXXXXXX
